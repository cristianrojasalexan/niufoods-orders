# Copy this file to .env to change any value. bin/dev (through foreman) and
# docker compose read it. docker compose only takes the published ports
# (DB_PORT, REDIS_PORT, WEB_PORT), STORE_MODES and the dispatch settings: it
# sets the connections itself, with its own database and Redis database 1.

# PostgreSQL (defaults match the db service in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (used by Sidekiq)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Base URL where each restaurant receives its orders (<base>/<CODE>/orders).
# Defaults to the simulated stores served by this app.
STORE_BASE_URL=http://localhost:3000/simulated_stores

# Initial mode of each simulated store: ok, reject, down or flaky:N.
# Modes changed with PUT /simulated_stores/:code/mode take precedence.
STORE_MODES=PROV=ok,LCON=ok,NUNO=ok

# Dispatch of orders to the stores (see docs/dispatch.md).
MAX_ATTEMPTS_PER_CYCLE=5
DISPATCH_LEASE_SECONDS=60
# Wait before retrying a transient failure: base * 2^(attempt - 1), capped.
# bin/dev and docker compose use 2 seconds unless set here; 10 otherwise.
DISPATCH_RETRY_BASE_SECONDS=2
DISPATCH_RETRY_MAX_SECONDS=300
# bin/dispatch_recovery: how often it runs, and how long past its next attempt
# a pending order waits for its scheduled job before being enqueued again.
DISPATCH_RECOVERY_INTERVAL_SECONDS=60
DISPATCH_RECOVERY_GRACE_SECONDS=30
