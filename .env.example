# PostgreSQL (defaults match the db service in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (used by Sidekiq)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Base URL where each restaurant receives its orders (<base>/<CODE>/orders).
# Defaults to the simulated stores served by this app.
STORE_BASE_URL=http://localhost:3000/simulated_stores
