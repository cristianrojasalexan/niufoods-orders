<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Niufoods · Órdenes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Niufoods Orders">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Refreshing the same page morphs it: only what changed is replaced and the scroll is kept %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-500 text-sm font-bold text-white">N</span>
          <span class="text-lg font-semibold tracking-tight">Niufoods <span class="font-normal text-slate-500">· Órdenes</span></span>
        <% end %>
        <nav class="flex items-center gap-4 text-sm text-slate-600">
          <%= link_to "Órdenes", root_path, class: "hover:text-slate-900" %>
          <%= link_to "Sidekiq", "/sidekiq", class: "hover:text-slate-900" if Rails.env.development? %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <% flash.each do |type, message| %>
        <div role="<%= type == "alert" ? "alert" : "status" %>" data-controller="dismiss"
             class="mb-6 flex items-start justify-between gap-4 rounded-lg border px-4 py-3 text-sm transition-opacity duration-300 <%= type == "alert" ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-300 bg-emerald-50 text-emerald-900" %>">
          <span><%= message %></span>
          <button type="button" data-action="dismiss#close" aria-label="Cerrar aviso" class="-my-1 rounded px-1 text-lg leading-none opacity-60 hover:opacity-100">&times;</button>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
