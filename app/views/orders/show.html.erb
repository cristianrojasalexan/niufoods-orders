<% content_for :title, "#{@order.number} · Niufoods" %>

<%= link_to "← Órdenes", orders_path, class: "text-sm text-slate-500 hover:text-slate-900" %>

<div class="mt-2 flex flex-wrap items-center justify-between gap-4">
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="font-mono text-2xl font-semibold tracking-tight"><%= @order.number %></h1>
    <%= dispatch_status_badge(@order) %>
    <%# Only while the dispatch can still change; a finished order stays as it is %>
    <%= render "shared/live_badge", live: true if @live %>
  </div>
  <%= link_to "Actualizar", order_path(@order), class: "rounded-md bg-white px-3 py-2 text-sm font-medium shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50" %>
</div>


<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% [ [ "Tienda", @order.restaurant.name ], [ "Tipo", order_type_label(@order) ],
       [ "Creada", safe_join([ order_time(@order.created_at), tag.span(relative_time(@order.created_at), class: "block text-xs font-normal text-slate-400") ]) ], [ "Total", clp(@order.total_amount) ] ].each do |label, value| %>
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></dt>
      <dd class="mt-1 font-semibold tabular-nums"><%= value %></dd>
    </div>
  <% end %>
</dl>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <section class="min-w-0 rounded-lg border border-slate-200 bg-white shadow-sm lg:col-span-2" aria-labelledby="items-title">
    <h2 id="items-title" class="border-b border-slate-200 px-4 py-3 font-semibold">Productos</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
          <tr>
            <th scope="col" class="whitespace-nowrap px-4 py-3">Producto</th>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">Cantidad</th>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">Precio unitario</th>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-right">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @order.order_items.sort_by(&:product_id).each do |item| %>
            <tr>
              <td class="px-4 py-3"><%= item.product.name %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= item.quantity %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= clp(item.unit_price) %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= clp(item.subtotal) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="border-t border-slate-200 font-semibold">
            <th scope="row" colspan="3" class="px-4 py-3 text-right">Total</th>
            <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= clp(@order.total_amount) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="border-t border-slate-200 px-4 py-3 text-xs text-slate-500">Precios del catálogo al momento de crear la orden.</p>
  </section>

  <section class="min-w-0 rounded-lg border border-slate-200 bg-white shadow-sm" aria-labelledby="customer-title">
    <h2 id="customer-title" class="border-b border-slate-200 px-4 py-3 font-semibold">Cliente</h2>
    <dl class="space-y-3 px-4 py-4 text-sm">
      <div>
        <dt class="text-slate-500">Nombre</dt>
        <dd class="font-medium"><%= @order.customer_name %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Teléfono</dt>
        <dd class="font-medium tabular-nums"><%= @order.customer_phone %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Dirección de entrega</dt>
        <dd class="font-medium"><%= @order.delivery? ? @order.delivery_address : "No aplica: retiro en tienda" %></dd>
      </div>
    </dl>
  </section>
</div>

<section class="mt-6 rounded-lg border border-slate-200 bg-white shadow-sm" aria-labelledby="dispatch-title">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
    <h2 id="dispatch-title" class="font-semibold">Despacho a tienda</h2>
    <% if @order.dispatch_failed? %>
      <%# The failed cycle being retried: a second click on the same failure must not open another cycle %>
      <%= button_to "Reintentar despacho", redispatch_order_path(@order), params: { cycle: @order.dispatch_cycle },
                    form: { data: { turbo_confirm: "¿Enviar de nuevo #{@order.number} a #{@order.restaurant.name}? Se abrirá un ciclo nuevo de #{Rails.configuration.x.dispatch.max_attempts_per_cycle} intentos." } },
                    data: { turbo_submits_with: "Reintentando…" },
                    class: "rounded-md bg-rose-500 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-rose-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-500 disabled:cursor-wait disabled:opacity-60" %>
    <% end %>
  </div>

  <div class="px-4 py-4 text-sm">
    <% if @order.dispatch_dispatched? %>
      <p>La tienda recibió la orden el <%= attempt_time(@order.dispatched_at) %>.</p>
    <% elsif @order.dispatch_failed? %>
      <p class="text-rose-800">No se pudo entregar: <span class="font-mono"><%= @order.last_dispatch_error %></span></p>
      <p class="mt-1 text-slate-500">Al reintentar se abre un nuevo ciclo con <%= Rails.configuration.x.dispatch.max_attempts_per_cycle %> intentos.</p>
    <% elsif @order.dispatch_dispatching? %>
      <p>Un worker la está enviando a la tienda (intento <%= @order.dispatch_attempts_count %> del ciclo <%= @order.dispatch_cycle %>).</p>
    <% else %>
      <p>Próximo intento: <%= attempt_time(@order.next_dispatch_at) %>.</p>
    <% end %>
  </div>

  <% if @order.dispatch_attempts.empty? %>
    <p class="border-t border-slate-200 px-4 py-6 text-center text-sm text-slate-500">Todavía no hay intentos de despacho.</p>
  <% else %>
    <%# One timeline per dispatch cycle, the latest first; within a cycle, in the order they happened %>
    <% attempts_by_cycle(@order).each do |cycle, attempts| %>
      <div id="cycle_<%= cycle %>" class="border-t border-slate-200">
        <h3 class="bg-slate-50 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-500">
          Ciclo <%= cycle %> · <%= pluralize(attempts.size, "intento") %>
        </h3>
        <ol class="ml-8 mr-4 my-4 border-l-2 border-slate-200 text-sm">
          <% attempts.each_with_index do |attempt, index| %>
            <% if index.positive? %>
              <li class="pb-3 pl-5 text-xs text-slate-400">
                <%= duration_label(attempt.created_at - attempts[index - 1].created_at) %> después
              </li>
            <% end %>
            <li id="<%= dom_id(attempt) %>" class="relative pb-4 pl-5 last:pb-1">
              <%= dispatch_outcome_dot(attempt) %>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-medium">Intento <%= attempt.attempt_number %></span>
                <%= dispatch_outcome_badge(attempt) %>
                <span class="tabular-nums text-slate-500"><%= attempt_time(attempt.created_at) %></span>
              </div>
              <p class="mt-1 text-xs text-slate-500">
                <span class="tabular-nums"><%= attempt.http_status ? "HTTP #{attempt.http_status}" : "Sin respuesta HTTP" %> · <%= attempt.duration_ms %> ms</span>
                <% if attempt.error_message %>
                  · <span class="font-mono"><%= attempt.error_message %></span>
                <% end %>
              </p>
            </li>
          <% end %>
          <% if cycle == @order.dispatch_cycle && @live %>
            <li class="relative pl-5 pt-1 text-xs text-slate-500">
              <span class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full bg-white ring-2 ring-sky-400 motion-safe:animate-pulse"></span>
              <% if @order.dispatch_dispatching? %>
                Enviando el intento <%= @order.dispatch_attempts_count %>…
              <% else %>
                Próximo intento a las <%= attempt_time(@order.next_dispatch_at) %>
              <% end %>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>
  <% end %>
</section>
